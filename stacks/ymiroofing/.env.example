# ─── Cloudflare ───────────────────────────────────────────────────────────────
# Cloudflare API Token — Zone.DNS:Edit permission for ymiroofing.com.au
# Create at: https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=your-cloudflare-api-token-here

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=n8n
POSTGRES_USER=n8n
# Use a strong random password: openssl rand -hex 24
POSTGRES_PASSWORD=change-this-strong-postgres-password

# ─── Redis ────────────────────────────────────────────────────────────────────
# Use a strong random password: openssl rand -hex 24
REDIS_PASSWORD=change-this-strong-redis-password

# ─── n8n ──────────────────────────────────────────────────────────────────────
# 32-character encryption key for n8n credentials store
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-this-32-char-hex-encryption-key-here

# ─── SMTP (for n8n alert emails) ──────────────────────────────────────────────
# Resend SMTP bridge: https://resend.com/docs/send-with-smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your-resend-api-key
SMTP_SENDER=n8n@ymiroofing.com.au
