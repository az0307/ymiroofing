# ─── Cloudflare ───────────────────────────────────────────────────────────────
# API Token with Zone.DNS:Edit permission for your agency domain
CF_API_TOKEN=your-cloudflare-api-token-here

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=aurora
POSTGRES_USER=aurora
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-this-strong-postgres-password

# ─── Redis ────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 24
REDIS_PASSWORD=change-this-strong-redis-password

# ─── n8n ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-this-32-char-hex-encryption-key
# n8n API key (generate in n8n UI after first boot: Settings → API → Create)
N8N_API_KEY=

# ─── AutoBoros Backend ────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTOBOROS_SECRET_KEY=change-this-secret-key
AUTOBOROS_PASSWORD=change-this-operator-password

# ─── Portainer Agent ──────────────────────────────────────────────────────────
# Must match the secret set in Portainer CE when adding the agent
PORTAINER_AGENT_SECRET=change-this-portainer-secret
