        "responseCode": 200,
        "options": {}
      },
      "id": "c3d4e5f6-a7b8-9012-cdef-345678901001",
      "name": "Missed Call Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "webhookId": "ymi-missed-call"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "mc1",
              "leftValue": "={{ $json.body.CallStatus || $json.CallStatus || '' }}",
              "rightValue": "no-answer",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3d4e5f6-a7b8-9012-cdef-345678901002",
      "name": "Is Missed Call?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "from": "REPLACE_WITH_TWILIO_FROM_NUMBER",
        "to": "={{ $json.body.From || $json.From }}",
        "message": "Hi! You just called YMI Roofing. Ben is on the tools right now but will call you back ASAP. Text your suburb & job details to this number for a quick quote. — YMI Roofing. Reply STOP to opt out."
      },
      "id": "c3d4e5f6-a7b8-9012-cdef-345678901003",
      "name": "SMS Callback Promise",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        1130,
        200
      ],
      "credentials": {
        "twilioApi": {
          "id": "REPLACE_WITH_TWILIO_CREDENTIAL_ID",
          "name": "Twilio — YMI Roofing"
        }
      }
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Opt-Outs",
          "mode": "name"
        },
        "options": {}
      },
      "name": "Read Opt-Out List",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        690,
        200
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets — YMI Roofing"
        }
      },
      "id": "c3d4e5f6-a7b8-9012-cdef-345678901004"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Spam Act 2003 (Cth) s16 - opt-out suppression gate.\n *\n * Every customer-facing Twilio send in this workflow sits behind this node.\n * An item that does not come out of here is never texted.\n *\n * Recipients are matched on their last 9 digits, so 0423 858 503,\n * +61423858503 and 61 423 858 503 all resolve to the same person.\n *\n * If the Opt-Outs sheet cannot be read, \"Read Opt-Out List\" fails and the\n * workflow stops before this node runs. That is deliberate: no list, no send.\n */\nconst key = (raw) => {\n  const digits = String(raw ?? '').replace(/\\D/g, '');\n  return digits.length >= 9 ? digits.slice(-9) : '';\n};\n\nconst optedOut = new Set(\n  $('Read Opt-Out List').all().map((row) => key(row.json.Phone)).filter(Boolean)\n);\n\n// Rebuilt from \"Missed Call Webhook\" so the nodes after this one keep seeing the\n// item they expect, rather than rows from the Opt-Outs sheet.\nconst source = $('Missed Call Webhook').first();\nconst recipient = key(source.json.body?.From ?? source.json.From);\n\nif (!recipient) return [];              // no usable number - nothing to send\nif (optedOut.has(recipient)) return []; // replied STOP - must not be contacted\nreturn [source];\n"
      },
      "name": "Suppress Opted-Out",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        910,
        200
      ],
      "executeOnce": true,
      "id": "c3d4e5f6-a7b8-9012-cdef-345678901005"
    }
  ],
  "connections": {
    "Missed Call Webhook": {
      "main": [
        [
          {
            "node": "Is Missed Call?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Missed Call?": {
      "main": [
        [
          {
            "node": "Read Opt-Out List",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Read Opt-Out List": {
      "main": [
        [
          {
            "node": "Suppress Opted-Out",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Suppress Opted-Out": {
      "main": [
        [
          {
            "node": "SMS Callback Promise",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
