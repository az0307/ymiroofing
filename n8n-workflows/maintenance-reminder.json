{
  "name": "YMI Roofing — Annual Maintenance Reminder",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 1 9 *"
            }
          ]
        }
      },
      "id": "e5f6a7b8-c9d0-1234-efab-567890123001",
      "name": "Sept 1 Annual Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "options": {}
      },
      "id": "e5f6a7b8-c9d0-1234-efab-567890123002",
      "name": "Read Past Customers",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        470,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets — YMI Roofing"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "mr1",
              "leftValue": "={{ $json.Status }}",
              "rightValue": "Job Complete",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "mr2",
              "leftValue": "={{ $json.Phone }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "mr3",
              "leftValue": "={{ $json['Maintenance Reminder Sent'] || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e5f6a7b8-c9d0-1234-efab-567890123003",
      "name": "Eligible for Reminder?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "from": "REPLACE_WITH_TWILIO_FROM_NUMBER",
        "to": "={{ $json.Phone }}",
        "message": "=Hi {{ $json.Name }}, it's Ben from YMI Roofing. With summer coming up, now's the perfect time to check your roof before the wet season. We offer free re-inspections for past customers — call or text 0423 858 503 to book. Reply STOP to opt out."
      },
      "id": "e5f6a7b8-c9d0-1234-efab-567890123004",
      "name": "Send Maintenance Reminder",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        910,
        200
      ],
      "credentials": {
        "twilioApi": {
          "id": "REPLACE_WITH_TWILIO_CREDENTIAL_ID",
          "name": "Twilio — YMI Roofing"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "row_number": "={{ $json.row_number }}",
            "Maintenance Reminder Sent": "={{ $now.format('dd/MM/yyyy') }}"
          },
          "matchingColumns": [
            "row_number"
          ],
          "schema": []
        },
        "options": {}
      },
      "id": "e5f6a7b8-c9d0-1234-efab-567890123005",
      "name": "Mark Reminder Sent",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        1130,
        200
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets — YMI Roofing"
        }
      }
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Opt-Outs",
          "mode": "name"
        },
        "options": {}
      },
      "name": "Read Opt-Out List",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        360,
        460
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets — YMI Roofing"
        }
      },
      "id": "e5f6a7b8-c9d0-1234-efab-567890123006"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Spam Act 2003 (Cth) s16 - opt-out suppression gate.\n *\n * Every customer-facing Twilio send in this workflow sits behind this node.\n * An item that does not come out of here is never texted.\n *\n * Recipients are matched on their last 9 digits, so 0423 858 503,\n * +61423858503 and 61 423 858 503 all resolve to the same person.\n *\n * If the Opt-Outs sheet cannot be read, \"Read Opt-Out List\" fails and the\n * workflow stops before this node runs. That is deliberate: no list, no send.\n */\nconst key = (raw) => {\n  const digits = String(raw ?? '').replace(/\\D/g, '');\n  return digits.length >= 9 ? digits.slice(-9) : '';\n};\n\nconst optedOut = new Set(\n  $('Read Opt-Out List').all().map((row) => key(row.json.Phone)).filter(Boolean)\n);\n\nconst allowed = [];\nfor (const item of $input.all()) {\n  const recipient = key(item.json.Phone);\n  if (!recipient) continue;              // no usable number - nothing to send\n  if (optedOut.has(recipient)) continue; // replied STOP - must not be contacted\n  allowed.push(item);\n}\nreturn allowed;\n"
      },
      "name": "Suppress Opted-Out",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        200
      ],
      "id": "e5f6a7b8-c9d0-1234-efab-567890123007"
    }
  ],
  "connections": {
    "Sept 1 Annual Trigger": {
      "main": [
        [
          {
            "node": "Read Opt-Out List",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Past Customers": {
      "main": [
        [
          {
            "node": "Eligible for Reminder?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Eligible for Reminder?": {
      "main": [
        [
          {
            "node": "Suppress Opted-Out",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Send Maintenance Reminder": {
      "main": [
        [
          {
            "node": "Mark Reminder Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Opt-Out List": {
      "main": [
        [
          {
            "node": "Read Past Customers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Suppress Opted-Out": {
      "main": [
        [
          {
            "node": "Send Maintenance Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all"
  },
  "versionId": "e5f6a7b8-c9d0-1234-efab-567890123000",
  "tags": [
    {
      "name": "ymi-roofing"
    }
  ]
}
