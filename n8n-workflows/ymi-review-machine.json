{
  "name": "YMI Review Machine",
  "nodes": [
    {
      "id": "b2c3d4e5-0001-0001-0001-000000000001",
      "name": "Weekly Schedule (Fri 4 PM AEST)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [{
            "field": "cronExpression",
            "expression": "0 6 * * 5"
          }]
        }
      }
    },
    {
      "id": "b2c3d4e5-0001-0001-0001-000000000099",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 460],
      "parameters": {}
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Get Completed Jobs",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [460, 380],
      "parameters": {
        "operation": "readRows",
        "documentId": {
          "__rl": true,
          "value": "={{ $vars.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Jobs",
          "mode": "name"
        },
        "options": {
          "filters": {
            "conditions": [
              { "field": "Status", "value": "Complete" },
              { "field": "Review Requested", "value": "" }
            ]
          }
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "2",
          "name": "Google Sheets"
        }
      }
    },
    {
      "id": "b2c3d4e5-0003-0003-0003-000000000003",
      "name": "Process Each Job",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [680, 380],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "b2c3d4e5-0004-0004-0004-000000000004",
      "name": "Generate Personalised SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, 300],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"system_instruction\": {\n    \"parts\": [{\n      \"text\": \"You are writing a friendly SMS for YMI Roofing asking a recent customer to leave a Google review. Keep it under 160 characters, warm, personal. Include their first name and reference the suburb or service. End with the review link placeholder [REVIEW_LINK].\"\n    }]\n  },\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"Customer: {{ $json['Customer Name'] }}\\nSuburb: {{ $json['Suburb'] }}\\nService completed: {{ $json['Service'] }}\"\n    }]\n  }],\n  \"generationConfig\": {\n    \"temperature\": 0.7,\n    \"maxOutputTokens\": 200\n  }\n}",
        "options": { "timeout": 30000 }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "1",
          "name": "Gemini API Key"
        }
      }
    },
    {
      "id": "b2c3d4e5-0005-0005-0005-000000000005",
      "name": "Build SMS Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300],
      "parameters": {
        "jsCode": "const geminiResponse = $input.first().json;\nconst rawText = geminiResponse.candidates?.[0]?.content?.parts?.[0]?.text ?? '';\n\nconst job = $('Process Each Job').first().json;\nconst reviewLink = $vars.GOOGLE_REVIEW_LINK ?? 'https://g.page/r/review';\n\nconst sms = rawText.replace('[REVIEW_LINK]', reviewLink).trim().slice(0, 320);\n\nreturn [{\n  json: {\n    job_id:          job['Job ID'] ?? '',\n    customer_name:   job['Customer Name'] ?? '',\n    customer_phone:  job['Customer Phone'] ?? '',\n    suburb:          job['Suburb'] ?? '',\n    service:         job['Service'] ?? '',\n    sms_text:        sms,\n    review_link:     reviewLink,\n    sent_at:         new Date().toISOString()\n  }\n}];"
      }
    },
    {
      "id": "b2c3d4e5-0006-0006-0006-000000000006",
      "name": "Send Review SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [1340, 300],
      "parameters": {
        "operation": "send",
        "from": "={{ $vars.TWILIO_FROM_NUMBER }}",
        "to":   "={{ $json.customer_phone }}",
        "message": "={{ $json.sms_text }}"
      },
      "credentials": {
        "twilioApi": {
          "id": "3",
          "name": "Twilio"
        }
      }
    },
    {
      "id": "b2c3d4e5-0007-0007-0007-000000000007",
      "name": "Mark Review Sent",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1560, 300],
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "={{ $vars.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Jobs",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Job ID":           "={{ $json.job_id }}",
            "Review Requested": "Yes",
            "Review Date":      "={{ $json.sent_at }}"
          },
          "matchingColumns": ["Job ID"]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "2",
          "name": "Google Sheets"
        }
      }
    }
  ],
  "connections": {
    "Weekly Schedule (Fri 4 PM AEST)": {
      "main": [[{ "node": "Get Completed Jobs", "type": "main", "index": 0 }]]
    },
    "Manual Trigger": {
      "main": [[{ "node": "Get Completed Jobs", "type": "main", "index": 0 }]]
    },
    "Get Completed Jobs": {
      "main": [[{ "node": "Process Each Job", "type": "main", "index": 0 }]]
    },
    "Process Each Job": {
      "main": [[{ "node": "Generate Personalised SMS", "type": "main", "index": 0 }]]
    },
    "Generate Personalised SMS": {
      "main": [[{ "node": "Build SMS Text", "type": "main", "index": 0 }]]
    },
    "Build SMS Text": {
      "main": [[{ "node": "Send Review SMS", "type": "main", "index": 0 }]]
    },
    "Send Review SMS": {
      "main": [[{ "node": "Mark Review Sent", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "tags": [{ "name": "ymi-roofing" }],
  "triggerCount": 1,
  "updatedAt": "2026-07-01T00:00:00.000Z",
  "versionId": "ymi-review-machine-v1"
}
