{
  "name": "YMI Review Machine",
  "nodes": [
    {
      "id": "b2c3d4e5-0001-0001-0001-000000000001",
      "name": "Weekly Schedule (Fri 4 PM AEST)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * 5"
            }
          ]
        }
      }
    },
    {
      "id": "b2c3d4e5-0001-0001-0001-000000000099",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        460
      ],
      "parameters": {}
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Get Completed Jobs",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        460,
        380
      ],
      "parameters": {
        "operation": "readRows",
        "documentId": {
          "__rl": true,
          "value": "={{ $vars.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Jobs",
          "mode": "name"
        },
        "options": {
          "filters": {
            "conditions": [
              {
                "field": "Status",
                "value": "Complete"
              },
              {
                "field": "Review Requested",
                "value": ""
              }
            ]
          }
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "2",
          "name": "Google Sheets"
        }
      },
      "executeOnce": true
    },
    {
      "id": "b2c3d4e5-0003-0003-0003-000000000003",
      "name": "Process Each Job",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        680,
        380
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "b2c3d4e5-0004-0004-0004-000000000004",
      "name": "Generate Personalised SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        900,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ system_instruction: { parts: [{ text: \"You are writing a friendly SMS for YMI Roofing asking a recent customer to leave a Google review. Keep it under 160 characters, warm, personal. Include their first name and reference the suburb or service. End with the review link placeholder [REVIEW_LINK].\" }] }, contents: [{ parts: [{ text: 'Customer: ' + ($json['Customer Name'] || '') + '\\nSuburb: ' + ($json['Suburb'] || '') + '\\nService completed: ' + ($json['Service'] || '') } ] }], generationConfig: { temperature: 0.7, maxOutputTokens: 200 } }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "1",
          "name": "Gemini API Key"
        }
      },
      "continueOnFail": true
    },
    {
      "id": "b2c3d4e5-0005-0005-0005-000000000005",
      "name": "Build SMS Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "jsCode": "const geminiResponse = $input.first().json;\nconst rawText = geminiResponse.candidates?.[0]?.content?.parts?.[0]?.text ?? '';\n\nconst job = $('Process Each Job').first().json;\nconst reviewLink = $vars.GOOGLE_REVIEW_LINK ?? 'https://g.page/r/review';\n\n/**\n * Spam Act 2003 (Cth) s18 - every commercial SMS must carry a working\n * unsubscribe facility. The wording above is written by a language model and\n * cannot be relied on to include one, or to phrase it in a way the opt-out\n * handler recognises. Strip whatever it invented and append the exact\n * sentence \"YMI Roofing - SMS Opt-Out Handler\" actually matches on.\n */\nconst OPT_OUT = 'Reply STOP to opt out.';\n\nlet body = rawText\n  .replace('[REVIEW_LINK]', reviewLink)\n  .replace(/\\s*(reply\\s+)?stop\\b[^.!?]*[.!?]?\\s*$/i, '')\n  .trim();\n\n// Leave room for the opt-out sentence rather than truncating it away.\nbody = body.slice(0, 320 - OPT_OUT.length - 1).trim();\n\nconst sms = (body + ' ' + OPT_OUT).trim();\n\nreturn [{\n  json: {\n    job_id:          job['Job ID'] ?? '',\n    customer_name:   job['Customer Name'] ?? '',\n    customer_phone:  job['Customer Phone'] ?? '',\n    suburb:          job['Suburb'] ?? '',\n    service:         job['Service'] ?? '',\n    sms_text:        sms,\n    review_link:     reviewLink,\n    sent_at:         new Date().toISOString()\n  }\n}];"
      }
    },
    {
      "id": "b2c3d4e5-0008-0008-0008-000000000008",
      "name": "Has SMS Text?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "b2c3d4e5-0008-0008-0008-000000000008-cond",
              "leftValue": "={{ $json.sms_text }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "b2c3d4e5-0006-0006-0006-000000000006",
      "name": "Send Review SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "operation": "send",
        "from": "={{ $vars.TWILIO_FROM_NUMBER }}",
        "to": "={{ $json.customer_phone }}",
        "message": "={{ $json.sms_text }}"
      },
      "credentials": {
        "twilioApi": {
          "id": "3",
          "name": "Twilio"
        }
      },
      "continueOnFail": true
    },
    {
      "id": "b2c3d4e5-0009-0009-0009-000000000009",
      "name": "Delivered OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1760,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "b2c3d4e5-0009-0009-0009-000000000009-cond",
              "leftValue": "={{ $json.sid }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "b2c3d4e5-0007-0007-0007-000000000007",
      "name": "Mark Review Sent",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        1980,
        300
      ],
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "={{ $vars.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Jobs",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Job ID": "={{ $('Build SMS Text').item.json.job_id }}",
            "Review Requested": "Yes",
            "Review Date": "={{ $('Build SMS Text').item.json.sent_at }}"
          },
          "matchingColumns": [
            "Job ID"
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "2",
          "name": "Google Sheets"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "readRows",
        "documentId": {
          "__rl": true,
          "value": "={{ $vars.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Opt-Outs",
          "mode": "name"
        },
        "options": {}
      },
      "name": "Read Opt-Out List",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        280,
        520
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "2",
          "name": "Google Sheets"
        }
      },
      "id": "b2c3d4e5-0010-0010-0010-000000000010"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Spam Act 2003 (Cth) s16 - opt-out suppression gate.\n *\n * Every customer-facing Twilio send in this workflow sits behind this node.\n * An item that does not come out of here is never texted.\n *\n * Recipients are matched on their last 9 digits, so 0423 858 503,\n * +61423858503 and 61 423 858 503 all resolve to the same person.\n *\n * If the Opt-Outs sheet cannot be read, \"Read Opt-Out List\" fails and the\n * workflow stops before this node runs. That is deliberate: no list, no send.\n */\nconst key = (raw) => {\n  const digits = String(raw ?? '').replace(/\\D/g, '');\n  return digits.length >= 9 ? digits.slice(-9) : '';\n};\n\nconst optedOut = new Set(\n  $('Read Opt-Out List').all().map((row) => key(row.json.Phone)).filter(Boolean)\n);\n\nconst allowed = [];\nfor (const item of $input.all()) {\n  const recipient = key(item.json.customer_phone);\n  if (!recipient) continue;              // no usable number - nothing to send\n  if (optedOut.has(recipient)) continue; // replied STOP - must not be contacted\n  allowed.push(item);\n}\nreturn allowed;\n"
      },
      "name": "Suppress Opted-Out",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        220
      ],
      "id": "b2c3d4e5-0011-0011-0011-000000000011"
    }
  ],
