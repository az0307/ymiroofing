{
  "name": "YMI Roofing \u2014 Lead Capture v2",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ymi-roofing-lead",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://ymiroofing.com.au"
        }
      },
      "id": "node-wh-01",
      "name": "Receive Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "webhookId": "ymi-lead-wh-01"
    },
    {
      "parameters": {
        "jsCode": "// \u2500\u2500 HONEYPOT GATE\nconst body = $input.first().json.body || $input.first().json || {};\nconst hp = body._hp_ymir || body.website_hp || '';\nif (hp.trim() !== '') { console.warn('[Aurora] Bot caught'); return []; }\n\n// \u2500\u2500 PHONE SANITIZE\nlet phone = (body.phone || '').trim().replace(/[\\s\\-()]/g, '');\nif (phone.startsWith('0')) phone = '+61' + phone.slice(1);\nif (!phone.startsWith('+')) phone = '+61' + phone;\n\n// \u2500\u2500 INPUT LIMITS\nconst trim = (v, n) => String(v || '').trim().slice(0, n);\nconst ts = new Date().toLocaleString('en-AU', { timeZone: 'Australia/Melbourne' });\n\nreturn [{ json: {\n  name:         trim(body.name, 100)    || 'Unknown',\n  first:        (trim(body.name, 100) || 'there').split(' ')[0],\n  phone,\n  raw_phone:    trim(body.phone, 20),\n  suburb:       trim(body.suburb, 100)  || 'Not provided',\n  service:      trim(body.service, 100) || 'Not specified',\n  message:      trim(body.message, 1000)|| 'None provided',\n  submitted_at: ts,\n  source:       trim(body.source, 50)   || 'ymi-roofing-website'\n}}];"
      },
      "id": "node-code-01",
      "name": "Sanitize and Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $json.submitted_at }}",
            "Name": "={{ $json.name }}",
            "Phone": "={{ $json.phone }}",
            "Suburb": "={{ $json.suburb }}",
            "Service": "={{ $json.service }}",
            "Message": "={{ $json.message }}",
            "Source": "={{ $json.source }}"
          }
        },
        "options": {}
      },
      "id": "node-sheets-01",
      "name": "Log to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "operation": "create",
        "from": "REPLACE_TWILIO_NUMBER",
        "to": "+61422093241",
        "message": "={{ '\ud83d\udea8 NEW LEAD \u2014 Y.M.I ROOFING \ud83d\udea8\\n\\n\ud83d\udc64 ' + $json.name + '\\n\ud83d\udcde ' + $json.phone + '\\n\ud83d\udccd ' + $json.suburb + '\\n\ud83d\udee0\ufe0f ' + $json.service + '\\n\ud83d\udcdd ' + $json.message + '\\n\\n\u23f1\ufe0f ' + $json.submitted_at + '\\nTap number above to call back.' }}",
        "options": {}
      },
      "id": "node-twilio-01",
      "name": "SMS to Ben Primary",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        900,
        160
      ]
    },
    {
      "parameters": {
        "operation": "create",
        "from": "REPLACE_TWILIO_NUMBER",
        "to": "+61423858503",
        "message": "={{ '\ud83d\udea8 YMI LEAD: ' + $json.name + ' | ' + $json.phone + ' | ' + $json.suburb + ' | ' + $json.service }}",
        "options": {}
      },
      "id": "node-twilio-02",
      "name": "SMS to Ben Secondary",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        900,
        320
      ]
    },
    {
      "parameters": {
        "operation": "create",
        "from": "REPLACE_TWILIO_NUMBER",
        "to": "={{ $json.phone }}",
        "message": "={{ 'Hi ' + $json.first + '! Thanks for reaching out to Y.M.I Roofing. Your enquiry for ' + $json.service + ' in ' + $json.suburb + ' has been received. Ben will call you back within 1 hour. For urgent jobs call 0422 093 241. \u2014 Y.M.I Roofing' }}",
        "options": {}
      },
      "id": "node-twilio-03",
      "name": "Confirmation SMS to Customer",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        900,
        480
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"success\": true, \"message\": \"Lead received\" }",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-respond-01",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1120,
        300
      ]
    }
  ],
  "connections": {
    "Receive Lead": {
      "main": [
        [
          {
            "node": "Sanitize and Validate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sanitize and Validate": {
      "main": [
        [
          {
            "node": "Log to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log to Google Sheets": {
      "main": [
        [
          {
            "node": "SMS to Ben Primary",
            "type": "main",
            "index": 0
          },
          {
            "node": "SMS to Ben Secondary",
            "type": "main",
            "index": 0
          },
          {
            "node": "Confirmation SMS to Customer",
            "type": "main",
            "index": 0
          },
          {
            "node": "Respond 200 OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "YMI Roofing"
    },
    {
      "name": "Lead Capture v2"
    },
    {
      "name": "Aurora"
    }
  ]
}